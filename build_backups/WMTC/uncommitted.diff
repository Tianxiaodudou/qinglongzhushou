+                        isDefault = true
+                    )
+                    authRepository.saveServer(serverConfig, password = state.password)
+
+                    _uiState.update { it.copy(isLoading = false, success = true) }
+                } else {
+                    val errorMsg = respBody?.message ?: "验证码错误，请重试"
